# Copy to .env and fill with your Supabase project values
# For local dev you need both VITE_ (frontend) and server-only vars
# For GitHub Pages (static), only VITE_ vars are needed at build time — use GitHub Secrets

# --- Supabase (frontend + backend) ---
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# --- Vite (embedded into JS bundle — publishable only!) ---
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxx
# For local dev with Express API: /api/visitors (proxied via vite.config.js:15)
# For GitHub Pages (no server): leave empty to use direct Supabase fallback
VITE_VISITOR_ENDPOINT=/api/visitors
# VITE_VISITOR_ENDPOINT=  <-- use this for static hosting

# --- Prisma — Supabase Postgres (server only, never VITE_) ---
# Direct connection (used for `npx prisma db push`)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres?sslmode=require
DIRECT_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres?sslmode=require
# If using Supabase pooler (recommended for Prisma runtime):
# DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require
# DIRECT_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# --- Backend API ---
PORT=3001
# Optional: require header x-admin-token for DELETE /api/visitors
# ADMIN_TOKEN=some-random-secret
